rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return isSignedIn()
        && userEmail() in [
          'alekcaballeromusic@gmail.com',
          'catalina.medina.leal@gmail.com',
          'musicalaasesor@gmail.com',
          'imusicala@gmail.com'
        ];
    }

    // Recursos de la biblioteca: escritura solo para admins de Musicala.
    //
    // OJO — la lectura abierta NO es un descuido, es carga estructural. El HUB
    // de estudiantes inicializa este proyecto como app secundaria y solo llama
    // getFirestore, nunca getAuth (ver Estudiantes HUB/src/firebase.js): sus
    // usuarios se autentican contra musicala-docentes-hub y bitacoras-de-clase,
    // y un token de Firebase solo vale en el proyecto que lo emitió. Cambiar
    // esto a `request.auth != null` deja sin recursos a todos los estudiantes
    // de inmediato, aunque hayan iniciado sesión. Para cerrarlo de verdad hay
    // que tocar antes el repo del HUB (Cloud Function o custom claims).
    match /recursos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Configuración (taxonomía, áreas…): solo hace falta con sesión iniciada
    // —el Manager la carga al entrar y el formulario de sugerencias la usa para
    // los desplegables—. Ninguna app externa la lee, así que no va abierta.
    // Escritura, solo admins.
    match /config/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sugerencias de docentes: cualquiera con cuenta de Google puede proponer un
    // recurso, pero nunca tocar la biblioteca. Solo los admins leen todas,
    // aceptan o rechazan; el autor solo ve el estado de lo que él mismo envió.
    match /sugerencias/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.creadoPor == userEmail());
      allow create: if isSignedIn()
        && request.resource.data.creadoPor == userEmail()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.titulo.size() <= 200;
      allow update, delete: if isAdmin();
    }

    // Todo lo demás, bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
